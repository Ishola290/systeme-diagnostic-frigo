# Configuration pour Render - GEMINI ONLY
# Variables d'environnement pour le déploiement

# === URLs des services (Render génère automatiquement) ===
MAIN_APP_URL=https://votre-app.onrender.com
CHAT_API_URL=https://votre-chat.onrender.com
IA_SERVICE_URL=https://votre-ia.onrender.com

# === IA Service Configuration ===
# Utiliser Gemini (compatible Render gratuit)
GEMINI_API_KEY=votre_clé_gemini_ici
GEMINI_MODEL=gemini-2.5-flash

# === Agent IA (vos modèles déployés) ===
AGENT_IA_URL=https://vos-modeles-prediction.onrender.com

# === Base de données ===
DATABASE_URL=sqlite:////data/chat_app.db

# === Sécurité ===
SECRET_KEY=votre_secret_key_ici
FLASK_ENV=production
DEBUG=False

# === Telegram (optionnel) ===
TELEGRAM_BOT_TOKEN=votre_token_bot_telegram
TELEGRAM_CHAT_ID=votre_chat_id

# === Logging ===
LOG_LEVEL=INFO
